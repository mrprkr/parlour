{
  "name": "parlour-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "build:parlour": "nx run parlour:build",
    "build:site": "nx run site:build",
    "build:desktop": "nx run desktop:bundle",
    "build:ios": "nx run ios:xcodebuild",
    "build:all": "nx run-many -t build && nx run desktop:bundle && nx run ios:xcodebuild",
    "dev": "pnpm -C packages/parlour dev",
    "dev:site": "nx run site:dev",
    "dev:desktop": "nx run desktop:app",
    "dev:ios": "nx run ios:app",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:ios": "nx run ios:xcodetest",
    "check": "nx run-many -t typecheck lint test",
    "cargo-check": "nx run desktop:cargo-check",
    "emit": "nx run design:emit",
    "icons": "nx run design:icons",
    "version:set": "node scripts/set-version.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/set-version.mjs --sync"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^3.0.3",
    "nx": "^23.2.1"
  }
}
