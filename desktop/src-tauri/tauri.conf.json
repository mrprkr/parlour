{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home Agent",
  "version": "0.1.0",
  "identifier": "io.stuntdouble.home-agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Home Agent",
        "width": 560,
        "height": 720,
        "minWidth": 460,
        "minHeight": 520,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "The house agent, and the switch that starts it",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
