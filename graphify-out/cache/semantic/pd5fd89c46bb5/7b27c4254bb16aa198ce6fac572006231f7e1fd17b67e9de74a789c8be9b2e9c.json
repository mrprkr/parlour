{"nodes": [{"id": "docs_wake_word", "label": "Your own wake word (docs/wake-word.md)", "file_type": "document", "source_file": "docs/wake-word.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_wake_word_custom_wake_word_training", "label": "Training a custom openWakeWord model", "file_type": "rationale", "source_file": "docs/wake-word.md", "source_location": "## Train it", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An hour on a free Colab GPU; the provider is the same three-stage pipeline for every word so a new word is a new .onnx file and one line of config. Spell target_word as 'hey parlor' because Piper synthesises the training clips and reads spellings literally; the model learns the sound. 2000 examples and 20000 steps tighten it noticeably over the defaults."}, {"id": "docs_wake_word_colab_notebook", "label": "openWakeWord Colab training notebook", "file_type": "concept", "source_file": "docs/wake-word.md", "source_location": "## Train it", "source_url": "https://colab.research.google.com/drive/1q1oe2zOyZp7UsB3jJiQ1IFn8z5YfjwEb", "captured_at": null, "author": null, "contributor": null}, {"id": "docs_wake_word_full_notebook", "label": "openWakeWord automatic_model_training.ipynb (full notebook)", "file_type": "concept", "source_file": "docs/wake-word.md", "source_location": "## Train it", "source_url": "https://github.com/dscripka/openWakeWord/blob/main/notebooks/automatic_model_training.ipynb", "captured_at": null, "author": null, "contributor": null, "rationale": "Two extra levers matter more than the numbers: target_phrase takes a list of spellings and custom_negative_phrases takes sound-alikes that should not fire."}, {"id": "docs_wake_word_false_activation_penalty", "label": "false_activation_penalty vs threshold", "file_type": "rationale", "source_file": "docs/wake-word.md", "source_location": "## Tune it", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom models score a little lower than stock ones so threshold can come down to 0.4. If it wakes for the room, raise false_activation_penalty and retrain rather than pushing threshold past 0.7, which mostly makes it deaf to you as well."}, {"id": "docs_wake_word_speech_embeddings_input", "label": "Wake model input: last 16 speech embeddings", "file_type": "concept", "source_file": "docs/wake-word.md", "source_location": "## Install it", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The provider feeds each word the last 16 speech embeddings; notebook-trained models for a few-syllable phrase expect exactly that, and onnxruntime-node can print a model's input and output names to check."}], "edges": [{"source": "docs_wake_word", "target": "docs_tuning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/wake-word.md", "source_location": "## Tune it", "weight": 1.0}, {"source": "docs_wake_word_custom_wake_word_training", "target": "docs_wake_word_colab_notebook", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/wake-word.md", "source_location": "## Train it", "weight": 1.0}, {"source": "docs_wake_word_custom_wake_word_training", "target": "docs_wake_word_full_notebook", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/wake-word.md", "source_location": "## Train it", "weight": 1.0}, {"source": "docs_wake_word_custom_wake_word_training", "target": "docs_architecture_openwakeword", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/wake-word.md", "source_location": "intro", "weight": 1.0}, {"source": "docs_wake_word_custom_wake_word_training", "target": "packages_parlour_src_providers_wake_openwakeword", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, 