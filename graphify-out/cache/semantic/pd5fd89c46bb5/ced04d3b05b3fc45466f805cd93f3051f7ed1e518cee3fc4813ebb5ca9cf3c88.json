{"nodes": [{"id": "docs_tuning", "label": "Tuning (docs/tuning.md)", "file_type": "document", "source_file": "docs/tuning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tuning_audio_settings", "label": "audio settings (inputDevice, silenceMs, silenceThreshold, maxUtteranceMs, bargeIn)", "file_type": "concept", "source_file": "docs/tuning.md", "source_location": "## Audio", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "silenceThreshold is an RMS level 0 to 1; a noisy room wants it higher, a quiet speaker lower. maxUtteranceMs is a safety net for a microphone that never goes quiet rather than a way to allow long questions."}, {"id": "docs_tuning_wake_settings", "label": "wake settings (words, threshold, refractoryMs)", "file_type": "concept", "source_file": "docs/tuning.md", "source_location": "## The wake word", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stock words hey_jarvis, alexa, hey_mycroft; any openWakeWord .onnx dropped into the models directory works. Raise threshold towards 0.7 for television false wakes, lower towards 0.4 if deaf; raise refractoryMs if it fires twice."}, {"id": "docs_tuning_voice_settings", "label": "tts settings (voice, speed, fallback)", "file_type": "concept", "source_file": "docs/tuning.md", "source_location": "## The voice", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kokoro British voices bf_emma, bf_isabella, bm_george, bm_lewis. An unknown voice falls through to the fallback and the log lists every voice. Kokoro downloads itself on first start so the fallback may speak until it is ready."}, {"id": "docs_tuning_llm_settings", "label": "llm settings (local, cloud, maxToolRounds)", "file_type": "concept", "source_file": "docs/tuning.md", "source_location": "## The models", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A model that regularly exceeds local.timeoutMs is too big for the machine and with onLocalFailure every timeout becomes a slower, non-private cloud answer. cloud.enabled false keeps everything local and drops the escalation tool. Six tool rounds is enough for 'turn the kitchen and hall lights off and set a timer'. How often the cloud is asked is decided by the prompt, not a threshold."}, {"id": "docs_tuning_search_settings", "label": "search settings (searxng, brave, none)", "file_type": "concept", "source_file": "docs/tuning.md", "source_location": "## Search", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the local model uses this; the cloud model brings its own search. SearXNG needs json under search.formats."}, {"id": "docs_tuning_log_level", "label": "LOG_LEVEL and service logs", "file_type": "concept", "source_file": "docs/tuning.md", "source_location": "## Logging", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_tuning", "target": "docs_wake_word", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tuning.md", "source_location": "## The wake word", "weight": 1.0}, {"source": "docs_tuning_audio_settings", "target": "docs_architecture_endpointer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tuning.md", "source_location": "## Audio", "weight": 1.0}, {"source": "docs_tuning_audio_settings", "target": "docs_architecture_voice_session_state_machine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tuning.md", "source_location": "## When something is not quite right (bargeIn)", "weight": 1.0}, {"source": "docs_tuning_audio_settings", "target": "docs_architecture_ffmpeg_avfoundation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "s