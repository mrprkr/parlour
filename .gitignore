node_modules/
dist/
.nx/
*.log
.DS_Store

# A checkout is not a home. Config, secrets and models live under
# ~/.config/parlour and ~/Library/Caches/parlour, never here.
.env
secrets.env
config.json
models/

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Every size, the .icns and the platform sets, all generated from
# src-tauri/icon.png by `pnpm icons`, which the build runs first. The source
# lives outside this directory because `tauri icon` writes icon.png into it,
# and a source that is also an output rewrites itself on every build.
apps/desktop/src-tauri/icons/

# Next writes all three; next-env.d.ts is regenerated by every build and dev
# run, and the tsbuildinfo by every typecheck.
apps/site/.next/
apps/site/next-env.d.ts
apps/site/tsconfig.tsbuildinfo
apps/site/.source/

# Claude Code's own worktrees; settings.json next to it is shared and checked in.
.claude/worktrees/

# This is one pnpm workspace with one lockfile at the root. Running `pnpm
# install` from inside a package writes a second one next to its package.json,
# which then goes stale and, on Vercel, competes with the root one for what
# gets installed. Ignored so a stray install does not end up in a commit.
apps/*/pnpm-lock.yaml
packages/*/pnpm-lock.yaml

# Written by `vercel link`; the project is identified by its git connection.
.vercel/
.env*.local

# Agent tooling installed into the checkout rather than written by hand: skills,
# subagent definitions and hook config for Claude Code, Codex and GitHub's agent
# runner. Tens of megabytes of somebody else's files, and a matter of whichever
# tools a given machine happens to have, not of how Parlour is built.
.agents/
.codex/
.claude/agents/
.claude/skills/
.github/agents/
.github/hooks/
.github/skills/
skills-lock.json

# Screenshots an interface review takes of the site as it goes.
apps/site/.impeccable/
