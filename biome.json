{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "packages/**",
      "apps/desktop/src/**",
      "apps/site/**",
      "scripts/**",
      "!**/dist",
      "!**/.next",
      "!**/next-env.d.ts",
      "!**/node_modules",
      "!**/target",
      "!**/.venv"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
