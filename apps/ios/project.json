{
  "name": "ios",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ios/Parlour",
  "targets": {
    "generate": {
      "command": "xcodegen generate",
      "options": { "cwd": "apps/ios" },
      "outputs": ["{projectRoot}/Parlour.xcodeproj"]
    },
    "app": {
      "command": "open Parlour.xcodeproj",
      "options": { "cwd": "apps/ios" },
      "dependsOn": ["generate"]
    },
    "xcodebuild": {
      "command": "xcodebuild -scheme Parlour -destination 'generic/platform=iOS Simulator' build",
      "options": { "cwd": "apps/ios" },
      "dependsOn": ["generate"]
    },
    "xcodetest": {
      "command": "xcodebuild -scheme Parlour -destination 'platform=iOS Simulator,name=iPhone 16' test",
      "options": { "cwd": "apps/ios" },
      "dependsOn": ["generate"]
    }
  }
}
