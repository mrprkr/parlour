<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Every executable the App Store build carries (node, ffmpeg, whisper-server,
    llama-server) and every native module node loads. Apple's rule for helper
    tools is these two keys and nothing else: the tool joins the sandbox of
    the app that started it, with that app's entitlements, microphone
    included. Anything more here and the app is rejected at upload.
  -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
