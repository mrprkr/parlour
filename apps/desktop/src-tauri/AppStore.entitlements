<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The Mac App Store build, signed by appstore/package.sh rather than by
    Tauri. TEAM_ID is filled in there from APPLE_TEAM_ID; a local build with
    no team drops the two identifier keys and signs ad hoc, which is enough to
    run the app sandboxed on the machine that built it.

    Everything Parlour does is inside the sandbox: HOME is the container, so
    its config, secrets, models and logs all land there without being told.
  -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>TEAM_ID.io.parlour.desktop</string>
  <key>com.apple.developer.team-identifier</key>
  <string>TEAM_ID</string>

  <!-- The wake word, through ffmpeg, which inherits this. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- The cloud model, Home Assistant, MCP servers and the model downloads. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!--
    The server the phone page, the iOS app and satellites talk to, Bonjour so
    they can find it, and whisper and the local model on loopback.
  -->
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
