{
  "name": "site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/site/app",
  "targets": {
    "build": {
      "command": "pnpm run build",
      "options": { "cwd": "apps/site" },
      "outputs": ["{projectRoot}/.next", "!{projectRoot}/.next/cache"]
    },
    "dev": { "command": "pnpm run dev", "options": { "cwd": "apps/site" }, "continuous": true },
    "typecheck": { "command": "pnpm run typecheck", "options": { "cwd": "apps/site" } },
    "lint": { "command": "pnpm exec biome check .", "options": { "cwd": "apps/site" } }
  }
}
