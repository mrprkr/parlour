{
  "name": "@parlour/design",
  "version": "0.1.0",
  "private": true,
  "description": "The one palette, type scale and state vocabulary, and the emitters that write it into every surface",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "emit": "node --experimental-strip-types src/emit.ts",
    "emit:check": "node --experimental-strip-types src/emit.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
