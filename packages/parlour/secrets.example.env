# Secrets only. Everything else lives in config.json.
# Copy to ~/.config/parlour/secrets.env with mode 600; parlour reads it on
# start. `parlour secrets set NAME` writes one line for you.

# Home Assistant long lived access token: your profile page, Security tab,
# right at the bottom. This is the whole house, so treat it accordingly.
HA_TOKEN=

# Cloud escalation. Leave empty to run local only.
ANTHROPIC_API_KEY=

# Shared by everything on the network that talks to the agent: Home Assistant,
# the phone page, satellites. Without it the agent answers this machine only.
#   openssl rand -hex 24
PARLOUR_TOKEN=

# Only needed if search.provider is "brave".
BRAVE_API_KEY=

# debug, info, warn, error
LOG_LEVEL=info
