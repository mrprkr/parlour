<?xml version="1.0" encoding="UTF-8"?>
<!--
  Autostart for the agent. Copy both this and the whisper one into
  ~/Library/LaunchAgents, edit the paths, then:

    launchctl load -w ~/Library/LaunchAgents/io.stuntdouble.home-agent.plist

  A LaunchAgent, not a LaunchDaemon: it needs the logged in user's audio
  session to reach the microphone and the speakers, and it needs to be able to
  ask for microphone permission the first time it runs.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.stuntdouble.home-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>--experimental-strip-types</string>
    <string>--env-file-if-exists=/Users/CHANGEME/home-assistant/agent/.env</string>
    <string>/Users/CHANGEME/home-assistant/agent/src/index.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/CHANGEME/home-assistant/agent</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/home-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/home-agent.err</string>
</dict>
</plist>
